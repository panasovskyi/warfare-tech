# Зразок змінних середовища ingestion (локальний інструмент, на сервер не деплоїться).
# Скопіюй у `.env` (він у .gitignore). Cloudinary і публікація перевіряють свої змінні лише коли потрібні.

# Ключ API Anthropic: рерайт статей
ANTHROPIC_API_KEY=

# Cloudinary: сюди завантажуються головні фото й картинки в тексті
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Адреса API разом із `/api`. Для публікації на сайт це адреса ПРОДАКШН-API
API_BASE_URL=http://localhost:5000/api

# Адмін, від імені якого публікується стаття: пошта чи логін і пароль (як у сіду сервера)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
