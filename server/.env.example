# Зразок змінних середовища сервера. Скопіюй у `.env` (він у .gitignore) і підстав свої значення.
# На хостингу ці змінні задаються в панелі, а не файлом.

# Порт API. На хостингу його зазвичай задає сама платформа
PORT=5000

# development або production. У development Prisma пише запити в лог
NODE_ENV=development

# Адреса сайту (клієнта), без слеша в кінці: дозволений origin для CORS
CLIENT_URL=http://localhost:3000

# Скільки проксі стоїть перед сервером (число). Від нього залежить адреса клієнта, за якою
# рахується ліміт логіну. Необов'язкова: без неї діє 1
TRUST_PROXY=1

# Рядок підключення до PostgreSQL. На керованій базі зазвичай потрібен SSL: додай `?sslmode=require`
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Секрет підпису токенів доступу: довгий випадковий рядок (від 32 символів).
# На проді інший, ніж у розробці, і ніде не публікується
JWT_ACCESS_SECRET=change-me

# Адмін, якого створює сід (`npm run prisma:seed`). Логін адміна завжди `admin`.
# ADMIN_EMAIL не міняти після першого сіду (сід шукає адміна за поштою)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
