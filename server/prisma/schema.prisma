generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ArticleType {
  NEWS
  LONGREAD
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}
enum ArticleSubcategory {
  AIR
  LAND
  CYBER
  SPACE
  NAVAL
  UAV
}

model User {
  id String @id @default(uuid())

  email String  @unique
  login String  @unique
  fullName  String @map("full_name")
  password  String

  role  UserRole  @default(USER)

  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Article {
  id String @id @default(uuid())

  authorId  String @map("author_id")
  author User @relation(fields: [authorId], references: [id])

  type ArticleType
  subcategory ArticleSubcategory?
  status ArticleStatus @default(PUBLISHED)

  isFeatured Boolean @default(false) @map("is_featured")
  isWarInUkraine Boolean @default(false) @map("is_war_in_ukraine")

  mainPicture String @map("main_picture")
  photoCredit String? @map("photo_credit")
  photoAlt String? @map("photo_alt")

  slug  String  @unique
  title String
  description String @db.Text()
  body String @db.Text()
  readingTime Int @map("reading_time")

  tags String[]

  source     String?
  sourceLink String? @map("source_link")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("articles")
}