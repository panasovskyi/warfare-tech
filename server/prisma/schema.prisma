// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ArticleCategory {
  NEWS
  LONGREAD
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}
// TODO: перейменувати на ArticleSubcategory (міграція і імпорти generated/prisma/enums у
// схемах і сервісах)
enum Subcategory {
  AIR
  LAND
  CYBER
  SPACE
  NAVAL
  UAV
}

model User {
  id String @id @default(uuid())

  email String  @unique
  login String  @unique
  fullName  String @map("full_name")
  password  String

  role  UserRole  @default(USER)

  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Article {
  id String @id @default(uuid())

  authorId  String @map("author_id")
  author User @relation(fields: [authorId], references: [id])

  category ArticleCategory
  subcategory Subcategory?
  // TODO: за замовчуванням PUBLISHED, бо чернетки в базі не використовуємо (власник перевіряє
  // чернетку у файлі ingestion). Якщо чернетки з'являться в базі — змінити default
  status ArticleStatus @default(PUBLISHED)

  isFeatured Boolean @default(false) @map("is_featured")
  isWarInUkraine Boolean @default(false) @map("is_war_in_ukraine")

  mainPicture String @map("main_picture")
  // Хто автор головного фото: сайт малює "Photo: …" на самому фото
  photoCredit String? @map("photo_credit")
  // TODO: alt головного фото — поле опису (photoAlt): міграція, правило в create-article.schema,
  // дзеркало в ingestion, alt на фронті (зараз alt=''). Відкладено до проходу по доступності

  slug  String  @unique
  title String
  description String @db.Text()
  body String @db.Text()

  // TODO: немає поняття "добірка" для Special Report: фільтр за тегом або окрема модель
  // Collection (див. SpecialReportSection на фронті)
  tags String[]

  // TODO: sourceLink не унікальний: дублі перевіряє лише ingestion (читає 400 останніх статей).
  // Унікальний індекс по непорожніх або пошук за посиланням на сервері
  source     String?
  sourceLink String? @map("source_link")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("articles")
}